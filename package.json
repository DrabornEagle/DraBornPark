    "web": "node scripts/materialize-v124.mjs && expo start --web --clear",
    "typecheck": "node scripts/materialize-v124.mjs && node scripts/clean-generated-types.mjs && tsc --noEmit",
    "check": "node scripts/materialize-v124.mjs && node scripts/check-v124.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
