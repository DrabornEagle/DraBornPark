{
  "expo": {
    "name": "DraBornPark",
    "slug": "drabornpark",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "drabornpark",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050816",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050816",
          "dark": {
            "backgroundColor": "#050816"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark",
          "hidden": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DraBornPark yalnızca Park Ettim özelliğinde park konumunu kaydetmek ve Aracıma Git yönlendirmesini sağlamak için konumunu kullanır. Konum arka planda sürekli izlenmez."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DraBornPark park yeri, otopark bileti ve isteğe bağlı araç bildirimi fotoğrafları için kamerayı yalnızca sen bu özelliği seçtiğinde kullanır.",
          "photosPermission": "DraBornPark seçtiğin park veya araç görsellerini hesabına ekleyebilmek için fotoğraflarına erişir."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "drabornpark-alerts-v3"
        }
      ],
      [
        "expo-iap",
        {}
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.draborneagle.drabornpark",
      "versionCode": 6,
      "backgroundColor": "#050816",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "icon": "./assets/branding/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#050816"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.draborneagle.com",
              "pathPrefix": "/DraBornPark/tag/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.draborneagle.drabornpark",
      "deploymentTarget": "15.1"
    },
    "web": {
      "output": "single"
    },
    "icon": "./assets/branding/icon.png"
  }
}
