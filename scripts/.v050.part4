n name=\"arrow-right\" size={19} color={palette.ink}/></View></Pressable>;\n  const accent=vehicle.vehicle_type==='motorcycle'?palette.purple:palette.cyan;const tagColor=tag?palette.green:palette.orange;\n  return <Animated.View style={[s.vehicleCore,{borderColor:`${accent}9A`,backgroundColor:'#062833',transform:[{scale:pulse.interpolate({inputRange:[0,1],outputRange:[1,1.006]})}]}]}>\n    <Animated.View pointerEvents=\"none\" style={{position:'absolute',top:-30,bottom:-30,width:94,backgroundColor:`${palette.blue}12`,transform:[{translateX:scan.interpolate({inputRange:[0,1],outputRange:[-130,760]})},{rotate:'12deg'}]}}/>\n    <View style={s.vehiclePremiumBand}><View style={[s.vehicleBandMain,{backgroundColor:accent}]}/><View style={[s.vehicleBandPart,{backgroundColor:palette.blue}]}/><View style={[s.vehicleBandPart,{backgroundColor:palette.pink}]}/><View style={[s.vehicleBandPart,{backgroundColor:palette.green}]}/></View>\n    <View style={s.vehicleHeaderLine}><Animated.View style={[s.vehicleLiveBadge,{transform:[{scale:pulse.interpolate({inputRange:[0,1],outputRange:[1,1.045]})}]}]}><Animated.View style={[s.vehicleLiveDot,{opacity:pulse.interpolate({inputRange:[0,1],outputRange:[.55,1]})}]}/><Text style={s.vehicleLiveText}>CANLI ARA\u00c7</Text></Animated.View><Pill label={plus?'PLUS':'TEMEL'} color={plus?palette.yellow:palette.blue} icon={plus?'crown-outline':'shield-outline'}/></View>\n    <View style={s.coreTop}>\n      <Animated.View style={[s.coreIconFrame,{borderColor:`${accent}A8`,backgroundColor:`${accent}1F`,transform:[{scale:pulse.interpolate({inputRange:[0,1],outputRange:[1,1.025]})}]}]}><View style={[s.coreIcon,{backgroundColor:`${accent}38`}]}><SafeIcon name={vehicle.vehicle_type==='motorcycle'?'motorbike':'car-connected'} size={43} color={accent}/></View><View style={s.onlineDot}/><View style={{position:'absolute',left:-5,top:12,width:8,height:28,borderRadius:8,backgroundColor:palette.pink}}/></Animated.View>\n      <View style={{flex:1}}><Text style={[s.coreEyebrow,{color:accent}]}>AKT\u0130F ARA\u00c7</Text><Text style={s.coreName}>{vehicle.vehicle_name}</Text><View style={s.plateRow}><SafeIcon name=\"card-text-outline\" size={16} color={accent}/><Text style={[s.corePlate,{color:accent}]}>{vehicle.plate||'Plaka gizli'}</Text></View><Text style={s.coreMeta}>{[vehicle.brand,vehicle.model,vehicle.color].filter(Boolean).join(' \u2022 ')}</Text></View>\n    </View>\n    <View style={s.coreStatusGrid}>\n      <View style={[s.vehicleStatus,{borderColor:`${tagColor}78`,backgroundColor:`${tagColor}19`}]}><View style={[s.vehicleStatusIcon,{backgroundColor:`${tagColor}32`}]}><SafeIcon name={tag?'nfc-variant':'qrcode-scan'} size={25} color={tagColor}/></View><View style={{flex:1}}><Text style={s.vehicleStatusLabel}>ET\u0130KET DURUMU</Text><Text numberOfLines={1} style={[s.vehicleStatusValue,{color:tagColor}]}>{tag?'NFC + QR AKT\u0130F':'ET\u0130KET BEKL\u0130YOR'}</Text></View></View>\n      <View style={[s.vehicleStatus,{borderColor:`${palette.green}78`,backgroundColor:`${palette.green}19`}]}><View style={[s.vehicleStatusIcon,{backgroundColor:`${palette.green}32`}]}><SafeIcon name=\"shield-lock-outline\" size={25} color={palette.green}/></View><View style={{flex:1}}><Text style={s.vehicleStatusLabel}>G\u0130ZL\u0130L\u0130K</Text><Text style={[s.vehicleStatusValue,{color:palette.green}]}>KORUMALI</Text></View></View>\n    </View>\n    <View pointerEvents=\"none\" style={{position:'absolute',left:16,right:16,bottom:0,height:4,flexDirection:'row',gap:3}}><View style={{flex:2,backgroundColor:accent,borderRadius:8}}/><View style={{flex:1,backgroundColor:palette.pink,borderRadius:8}}/><View style={{flex:1,backgroundColor:palette.orange,borderRadius:8}}/><View style={{flex:1,backgroundColor:palette.green,borderRadius:8}}/></View>\n  </Animated.View>;\n}");

