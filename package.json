    "expo": "~57.0.17",
    "expo-build-properties": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-iap": "5.3.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
