,setTransferCode]=useState('');const [vehicleId,setVehicleId]=useState('');const [busy,setBusy]=useState(false);const activatePulse=useRef(new Animated.Value(0)).current;const activateSweep=useRef(new Animated.Value(0)).current;useEffect(()=>{const p=Animated.loop(Animated.sequence([Animated.timing(activatePulse,{toValue:1,duration:900,easing:Easing.inOut(Easing.cubic),useNativeDriver:true}),Animated.timing(activatePulse,{toValue:0,duration:900,easing:Easing.inOut(Easing.cubic),useNativeDriver:true})]));const q=Animated.loop(Animated.timing(activateSweep,{toValue:1,duration:2600,easing:Easing.linear,useNativeDriver:true}));p.start();q.start();return()=>{p.stop();q.stop()}},[activatePulse,activateSweep]);");
