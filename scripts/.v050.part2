canceled||!result.assets?.[0])return;\n      const asset:any=result.assets[0];\n      await uploadProfileAvatar({uri:asset.uri,mimeType:asset.mimeType,fileName:asset.fileName});\n      Haptics.notificationAsync(Haptics.NotificationFeedbackType.Success);\n      await refresh();\n    }catch(e:any){Alert.alert('Profil resmi de\u011fi\u015ftirilemedi',e?.message||'L\u00fctfen tekrar dene.')}\n  }\n  return <SafeAreaView style={s.safe}><AuroraBackground accent={palette.cyan} secondary={palette.purple}/><Animated.View style={{flex:1,opacity:enter,transform:[{translateY:enter.interpolate({inputRange:[0,1],outputRange:[14,0]})}]}}>\n    <ScrollView contentContainerStyle={[s.scroll,{paddingBottom:130}]} showsVerticalScrollIndicator={false} onScroll={e=>setDockSolid(e.nativeEvent.contentOffset.y>24)} scrollEventThrottle={16} refreshControl={<RefreshControl refreshing={refreshing} onRefresh={refresh} tintColor={palette.cyan}/>}>\n      <Greeting name={name} subtitle=\"Arac\u0131n\u0131n bug\u00fcnk\u00fc durumunu tek bak\u0131\u015fta g\u00f6r\" onAccount={()=>router.push('/account')} avatarUrl={live?.profile?.avatar_url} onAvatarPress={editAvatar} unread={unread}/>\n      <VehicleCore vehicle={vehicle} tag={tag?.tag_code} plus={plus}/>\n      <SectionHeading title=\"H\u0131zl\u0131 eri\u015fim\" subtitle=\"En s\u0131k kullanaca\u011f\u0131n alanlar\"/><QuickRail items={liveQuick} open={item=>item.route&&router.push(item.route as any)}/>\n      <View style={s.primaryRow}><HeroAction icon=\"map-marker-plus-outline\" color={palette.cyan} title=\"PARK ETT\u0130M\" detail=\"Konumu ve park detay\u0131n\u0131 kaydet\" onPress={()=>router.push('/park')}/><HeroAction icon=\"navigation-variant\" color={palette.orange} title=\"ARACIMA G\u0130T\" detail={park?.place_name||'Aktif park yok'} onPress={goToCar} disabled={!park?.latitude}/></View>\n      {park?<ParkPulse park={park}/>:null}\n      <SectionHeading title=\"Bug\u00fcnk\u00fc durum\" subtitle=\"\u00d6nemli bilgilerin h\u0131zl\u0131 \u00f6zeti\" badge={unread?`${unread} YEN\u0130`:'TEM\u0130Z'} color={unread?palette.orange:palette.green}/><View style={s.metricRow}><MetricChip icon=\"bell-outline\" color={palette.orange} value={String(unread)} label=\"Yeni bildirim\"/><MetricChip icon=\"parking\" color={palette.cyan} value={String(insights.parks)} label=\"Bu ay park\"/><MetricChip icon=\"nfc\" color={tag?palette.green:palette.muted} value={tag?'AKT\u0130F':'YOK'} label=\"Etiket\"/></View>\n      <View style={s.featurePair}><FeatureCard icon=\"chart-donut\" color={palette.green} title=\"\u0130statistiklerim\" body={`${insights.parks} park \u2022 ${insights.reports} bildirim`} onPress={()=>router.push('/insights')}/><FeatureCard icon=\"shield-lock-outline\" color={palette.purple} title=\"Gizlilik & Veri\" body=\"\u0130zinler, veriler ve hesap\" onPress={()=>router.push('/legal')}/></View>\n      <SectionHeading title=\"Son olay\" subtitle=\"Ara\u00e7 ge\u00e7mi\u015findeki en yeni kay\u0131t\"/><Pressable onPress={()=>router.push('/timeline')} style={({pressed})=>[s.event,pressed&&s.pressed]}><View style={[s.eventIcon,{backgroundColor:`${palette.pink}20`,borderColor:`${palette.pink}60`}]}><SafeIcon name=\"history\" size={27} color={palette.pink}/></View><View style={{flex:1}}><Text style={s.eventTitle}>{live?.timeline?.[0]?.title||'Ara\u00e7 ge\u00e7mi\u015fi hen\u00fcz bo\u015f'}</Text><Text style={s.eventBody}>{live?.timeline?.[0]?.description||'\u0130lk park veya ara\u00e7 bildiriminle ge\u00e7mi\u015fin ba\u015flayacak.'}</Text></View><SafeIcon name=\"arrow-right\" size={23} color={palette.pink}/></Pressable>\n      <Pressable onPress={signOut} style={s.signOut}><SafeIcon name=\"logout\" size={20} color={palette.muted2}/><Text style={s.signOutText}>Oturumu kapat</Text></Pressable>\n    </ScrollView>\n    <BottomDock active=\"home\" onHub={()=>router.push('/hub')} transparent={!dockSolid} floating/>\n  </Animated.View></SafeAreaView>;\n}");
between('app/index.tsx',"function DemoHome","function Greeting","function DemoHome({enter}:{enter:Animated.Value}){\n  const demo=useDemo();const st=demo.state;const [dockSolid,setDockSolid]=useState(false);const vehicle=st.vehicles.find((v:any)=>v.active)||st.vehicles[0];const park=st.parks.find((p:any)=>!p.endedAt)||st.parks[0];const unread=st.notifications.filter((n:any)=>!n.seen).length;const open=(section:DemoSection)=>router.push({pathname:'/demo/[section]',params:{section}} as any);\n  return <SafeAreaView style={s.safe}><AuroraBackground accent={palette.yellow} secondary={palette.purple}/><Animated.View style={{flex:1,opacity:enter}}>\n    <ScrollView contentContainerStyle={[s.scroll,{paddingBottom:130}]} showsVerticalScrollIndicator={false} onScroll={e=>setDockSolid(e.nativeEvent.contentOffset.y>24)} scrollEventThrottle={16}>\n      <Greeting name={st.profile.username||st.profile.displayName} subtitle=\"Demo alan\u0131 canl\u0131 hesab\u0131ndan tamamen ayr\u0131\" demo onAccount={demo.stop} unread={unread}/>\n      <View style={s.demoNotice}><View style={s.demoNoticeIcon}><SafeIcon name=\"flask-outline\" size={27} color={palette.yellow}/></View><View style={{flex:1}}><Text style={s.demoNoticeTitle}>Tam Demo Alan\u0131</Text><Text style={s.demoNoticeBody}>Park, bildirim, etiket, aile ve mod de\u011fi\u015fiklikleri Demo ekranlar\u0131nda an\u0131nda g\u00f6r\u00fcn\u00fcr.</Text></View><Pressable onPress={demo.reset} style={s.demoReset}><SafeIcon name=\"refresh\" size={20} color={palette.yellow}/></Pressable></View>\n      <VehicleCore vehicle={{vehicle_name:vehicle.name,plate:vehicle.plate,brand:vehicle.brand,model:vehicle.model,color:vehicle.color,vehicle_type:vehicle.type}} tag={vehicle.tagCode} plus/>\n      <SectionHeading title=\"H\u0131zl\u0131 eri\u015fim\" subtitle=\"Demo i\u00e7eriklerinin tamam\u0131n\u0131 test et\"/><QuickRail items={demoQuick} open={item=>item.demo&&open(item.demo)}/>\n      <View style={s.primaryRow}><HeroAction icon=\"map-marker-plus-outline\" color={palette.cyan} title=\"P